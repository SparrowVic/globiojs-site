{
  "name": "globiojs-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert 'performance sample'",
    "test:performance": "playwright test e2e/performance.spec.ts --project desktop",
    "test:e2e:report": "playwright show-report output/playwright/report",
    "test:bundle": "node scripts/performance-bundle.mjs",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "docs:extract": "node scripts/docs-extract.mjs",
    "docs:check": "node scripts/docs-extract.mjs --check",
    "icons:install-pro": "node scripts/fontawesome-install.mjs",
    "test:icons": "node --test scripts/fontawesome-config.test.mjs",
    "build:netlify": "node scripts/fontawesome-build.mjs",
    "check:public": "node scripts/check-public-dependencies.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "7.2.0",
    "@fortawesome/free-brands-svg-icons": "7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@globiojs/core": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.167.1",
    "tw-animate-css": "^1.4.0",
    "@fortawesome/free-solid-svg-icons": "7.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vitest": "^1.6.0",
    "@globiojs/react": "0.1.0",
    "@globiojs/vue": "0.1.0",
    "@globiojs/angular": "0.1.0",
    "@angular/core": "~17.3.12",
    "@angular/common": "~17.3.12",
    "rxjs": "^7.8.0",
    "vue": "^3.4.0",
    "@types/three": "0.167.0",
    "@types/node": "^22.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "pnpm": {
    "overrides": {
      "three": "0.167.1",
      "@types/three": "0.167.0"
    }
  }
}
